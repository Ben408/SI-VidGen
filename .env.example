APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
WEB_ORIGIN=http://localhost:5173

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma3:12b
OLLAMA_FALLBACK_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_TOP_K=6
RAG_MIN_SCORE=0.20

INTACCT_HELP_START_URL=https://www.intacct.com/ia/docs/en_US/help_action/Intacct_basics/welcome.htm
INTACCT_HELP_ALLOWED_PREFIX=https://www.intacct.com/ia/docs/en_US/help_action/
CRAWL_DELAY_SECONDS=0.25

DATA_DIR=data
HELP_CACHE_DIR=data/help_xhtml
VECTOR_STORE_DIR=data/vector_store
RUNS_DIR=data/runs
OUTPUT_DIR=output
SCRIPTS_DIR=output/scripts
PAYLOADS_DIR=output/payloads
VIDEOS_DIR=output/videos
PUBLISHED_DIR=output/published

LOG_LEVEL=INFO

# Video backend: local_compositor (default, preserves Help screenshots)
# or higgsfield (cloud MCP / CLI token).
VIDEO_BACKEND=local_compositor
LOCAL_COMPOSITOR_TTS=true
# Neural Edge voices (natural). Alternatives: en-US-AndrewNeural, en-US-AriaNeural,
# en-GB-SoniaNeural. List with: edge-tts --list-voices
LOCAL_COMPOSITOR_VOICE=en-US-JennyNeural
LOCAL_COMPOSITOR_TTS_RATE=-5%
# Burn narration captions into the MP4 (demo-friendly; can override per run in UI).
LOCAL_COMPOSITOR_CAPTIONS=true

# After `higgsfield auth login`, generation uses Higgsfield MCP
# (trial/plus accounts reject CLI `generate create`).
# Optional: paste a bearer token to skip reading `higgsfield auth token`.
HIGGSFIELD_API_KEY=
HIGGSFIELD_WORKSPACE_ID=
HIGGSFIELD_JOB_TYPE=gemini_omni
HIGGSFIELD_WAIT_TIMEOUT_SECONDS=600
